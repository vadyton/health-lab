# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=health_lab

# Used for local dev (non-Docker). In docker-compose this is constructed automatically.
DATABASE_URL=postgresql://postgres:change_me_strong_password@localhost:5432/health_lab

# ── App ───────────────────────────────────────────────────────────────────────
PORT=3001

# Generate with: openssl rand -hex 64
JWT_SECRET=replace_with_generated_secret
